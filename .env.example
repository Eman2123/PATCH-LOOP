# Copy to .env on the VM and fill in. Never commit .env.
VULTR_API_KEY=
VULTR_BASE_URL=https://api.vultrinference.com/v1
MODEL_NAME=glm-5.3

# Public hostname. No domain? use <VM_IP with dashes>.sslip.io, e.g. 203-0-113-5.sslip.io
DOMAIN=localhost

# Sandbox (set SANDBOX_RUNTIME=runsc after gVisor is installed)
SANDBOX_IMAGE=patchloop-sandbox:latest
SANDBOX_RUNTIME=
SANDBOX_TIMEOUT_S=20
SANDBOX_MEMORY=256m
