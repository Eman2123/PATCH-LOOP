# Copy to .env on the VM and fill in. Never commit .env.
VULTR_API_KEY=
VULTR_BASE_URL=https://api.vultrinference.com/v1
MODEL_NAME=glm-5.3

# Public hostname. No domain? use <VM_IP with dashes>.sslip.io, e.g. 203-0-113-5.sslip.io
DOMAIN=localhost

# Sandbox (set SANDBOX_RUNTIME=runsc after gVisor is installed)
SANDBOX_IMAGE=patchloop-sandbox:latest
SANDBOX_RUNTIME=
SANDBOX_TIMEOUT_S=20
SANDBOX_MEMORY=256m

# LLM behaviour (run scripts/model_test.py to pick TOOL_MODE)
TOOL_MODE=native
LLM_CACHE_PATH=results/llm_cache.jsonl
# glm-5.3 reasons before it answers; thinking tokens count against this budget
LLM_MAX_TOKENS=4096
# Optional: a different (often cheaper, more gullible) model to play OfficeBot. The attacker and
# patcher keep using MODEL_NAME. Leave empty to use MODEL_NAME for everything.
WORKER_MODEL_NAME=

# API
ADMIN_TOKEN=
CORS_ORIGINS=*
PATCHLOOP_DB=data/patchloop.db
RESULTS_DIR=../results

# summary (default) or actions: the user asks OfficeBot to carry out the action items in the document
ATTACK_TASK_STYLE=summary
# 1 = run OfficeBot as a SIMULATED compromised agent that obeys instructions in documents (label this in any demo)
SUSCEPTIBLE_AGENT=0
